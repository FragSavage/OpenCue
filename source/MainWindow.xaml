<Window x:Class="OpenCue.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenCue — Free Windows audio" Width="1180" Height="820" MinWidth="1040" MinHeight="760"
        WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="EqSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Height" Value="126" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Minimum" Value="-12" />
            <Setter Property="Maximum" Value="6" />
            <Setter Property="SmallChange" Value="0.5" />
            <Setter Property="LargeChange" Value="1" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="TickFrequency" Value="0.5" />
        </Style>
    </Window.Resources>
    <Grid Margin="32,22,32,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,19">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="35" Height="35" CornerRadius="10" Background="#203B3A" Margin="0,0,11,0">
                    <Viewbox Width="21" Height="21"><Canvas Width="24" Height="24"><Line X1="3" Y1="9" X2="3" Y2="15" Stroke="#66E2D5" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /><Line X1="9" Y1="4" X2="9" Y2="20" Stroke="#66E2D5" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /><Line X1="15" Y1="7" X2="15" Y2="17" Stroke="#66E2D5" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /><Line X1="21" Y1="10" X2="21" Y2="14" Stroke="#66E2D5" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
                </Border>
                <TextBlock Text="OpenCue" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Margin="14,0,0,0" Background="#222933" CornerRadius="5" Padding="8,4" VerticalAlignment="Center"><TextBlock Text="FREE AUDIO" FontSize="10" FontWeight="Bold" Foreground="#AFC0CC" /></Border>
            </StackPanel>
            <Border Grid.Column="1" Background="#191E25" BorderBrush="#303A45" BorderThickness="1" CornerRadius="8" Padding="13,9" VerticalAlignment="Center" MaxWidth="420">
                <StackPanel Orientation="Horizontal"><TextBlock Text="ENGINE" FontSize="10" FontWeight="Bold" Foreground="#A1ACB8" Margin="0,0,10,0" VerticalAlignment="Center" /><TextBlock x:Name="EngineText" Text="Checking Equalizer APO…" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /></StackPanel>
            </Border>
        </Grid>
        <TabControl x:Name="MainTabs" Grid.Row="1">
            <TabItem Header="Sound">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,22,12,20">
                        <Grid Margin="0,0,0,23">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Hear the detail." FontSize="34" FontWeight="SemiBold" /><TextBlock Text="Shape your sound. Keep every control. Pay nothing." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" /></StackPanel>
                            <CheckBox x:Name="EnableToggle" Grid.Column="1" IsChecked="True" Content="Include processing when applied" VerticalAlignment="Center" Margin="20,8,0,0" ToolTip="Changes are written to the audio engine when you select Apply sound." />
                        </Grid>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="OUTPUT DEVICE" Style="{StaticResource Label}" /><ComboBox x:Name="DeviceBox" AutomationProperties.Name="Output device" ToolTip="Choose the playback device configured for Equalizer APO." /><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button x:Name="RefreshButton" Content="Refresh" Padding="10,5" MinHeight="28" FontSize="11" /><TextBlock Text="Choose stereo headphones here. For a virtual 7.1 output, use Spatial &amp; routing." Foreground="#A1ACB8" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="300" /></StackPanel></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="SOUND PRESET" Style="{StaticResource Label}" /><ComboBox x:Name="PresetBox" AutomationProperties.Name="Sound preset" /><TextBlock x:Name="PresetDescription" Text="Choose a starting point, then adjust for your ears and headphones." FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,11,0,0" LineHeight="18" /></StackPanel>
                            </Grid>
                        </Border>
                        <Border Background="#172725" BorderBrush="#2D4945" BorderThickness="1" CornerRadius="12" Padding="20,17" Margin="0,16,0,0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="Listening modes" FontWeight="SemiBold" FontSize="15" /><TextBlock Text="Choose a starting point. Fine-tune any control below." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,20,0" /></StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="NaturalModeButton" Content="Natural" MinWidth="95" /><Button x:Name="CompressedModeButton" Content="Compressed" Margin="9,0,0,0" MinWidth="112" /><Button x:Name="BoostModeButton" Content="Boost" Margin="9,0,0,0" MinWidth="90" /></StackPanel>
                            </Grid>
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,16,0,0">
                            <StackPanel>
                                <Grid><TextBlock Text="Equalizer" Style="{StaticResource SectionTitle}" /><TextBlock Text="10 BANDS  /  -12 to +6 dB" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,8" /></Grid>
                                <Grid Height="152" Margin="0,3,0,13" ClipToBounds="True">
                                    <Border Background="#12171D" CornerRadius="8" />
                                    <Grid Margin="14,14,14,22" IsHitTestVisible="False"><Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions><Border BorderBrush="#26313C" BorderThickness="0,0,0,1" /><Border Grid.Row="1" BorderBrush="#43515F" BorderThickness="0,0,0,1" /><Border Grid.Row="2" BorderBrush="#26313C" BorderThickness="0,0,0,1" /></Grid>
                                    <Canvas x:Name="CurveCanvas" Margin="14,14,14,22" ClipToBounds="True" Background="Transparent" IsHitTestVisible="False" />
                                    <TextBlock Text="BASS" FontSize="9" Foreground="#728393" VerticalAlignment="Bottom" Margin="14,0,0,6" /><TextBlock Text="MIDRANGE" FontSize="9" Foreground="#728393" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" /><TextBlock Text="TREBLE" FontSize="9" Foreground="#728393" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,6" />
                                </Grid>
                                <StackPanel x:Name="BandPanel" Orientation="Horizontal" HorizontalAlignment="Center" />
                                <StackPanel Margin="0,18,0,0">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions><Button x:Name="ImportCorrectionButton" Content="Import headphone EQ" Padding="12,7" MinHeight="33" FontSize="12" /><Button x:Name="ClearCorrectionButton" Grid.Column="1" Content="Clear correction" Padding="12,7" MinHeight="33" FontSize="12" Margin="9,0,0,0" /><TextBlock x:Name="CorrectionStatusText" Grid.Column="2" Text="Optional: import a compatible headphone EQ text file." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="18" VerticalAlignment="Center" Margin="15,0,0,0" /></Grid>
                                    <TextBlock Text="Curve shows tone sliders; an imported correction is applied separately." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0" />
                                </StackPanel>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,19,0,0" Padding="0,16,0,0">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /><ColumnDefinition Width="82" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Preamp / headroom" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="Leave room for boosted frequencies." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" /></StackPanel><Slider x:Name="HeadroomSlider" Grid.Column="1" Minimum="-24" Maximum="0" Value="-8" SmallChange="0.5" LargeChange="1" TickFrequency="0.5" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="16,0,14,0" AutomationProperties.Name="Preamp gain in decibels" /><TextBlock x:Name="PreampValue" Grid.Column="2" Text="−8.0 dB" FontFamily="Consolas" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" /></Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,16,0,0">
                            <StackPanel>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Compression" Style="{StaticResource SectionTitle}" /><TextBlock Text="Reduce the gap between quiet and loud sounds in the whole mix." FontSize="12" Foreground="{StaticResource MutedBrush}" /></StackPanel><CheckBox x:Name="DynamicsToggle" Grid.Column="1" IsChecked="False" Content="Compression" VerticalAlignment="Top" Margin="18,0,0,0" /></Grid>
                                <Grid Margin="0,19,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="30" /><ColumnDefinition /><ColumnDefinition Width="30" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="THRESHOLD" Style="{StaticResource Label}" /><Slider x:Name="ThresholdSlider" Minimum="-30" Maximum="0" Value="-12" SmallChange="1" LargeChange="3" AutomationProperties.Name="Compressor threshold in decibels" /></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="RATIO" Style="{StaticResource Label}" /><Slider x:Name="RatioSlider" Minimum="1" Maximum="8" Value="3" SmallChange="0.5" LargeChange="1" AutomationProperties.Name="Compression ratio" /></StackPanel>
                                    <StackPanel Grid.Column="4"><TextBlock Text="OUTPUT CEILING" Style="{StaticResource Label}" /><Slider x:Name="CeilingSlider" Minimum="-12" Maximum="-0.5" Value="-3" SmallChange="0.5" LargeChange="1" AutomationProperties.Name="Output ceiling in decibels" /></StackPanel>
                                </Grid>
                                <TextBlock x:Name="DynamicsText" Text="Threshold −12 dB     Ratio 3:1     Ceiling −3 dB" Foreground="{StaticResource MutedBrush}" FontFamily="Consolas" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,16,0,0">
                            <StackPanel>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Fine controls" Style="{StaticResource SectionTitle}" /><TextBlock Text="Adjust timing, background level and the stereo image." FontSize="12" Foreground="{StaticResource MutedBrush}" /></StackPanel><CheckBox x:Name="LimiterToggle" Grid.Column="1" IsChecked="True" Content="Peak protection" Margin="18,0,0,0" VerticalAlignment="Top" /></Grid>
                                <Grid Margin="0,23,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="28" /><ColumnDefinition /><ColumnDefinition Width="28" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Attack" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="Compressor response · 1–50 ms" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,8" /><Slider x:Name="AttackSlider" Minimum="1" Maximum="50" Value="4" SmallChange="1" LargeChange="5" AutomationProperties.Name="Compressor attack in milliseconds" /></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Release" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="Compressor recovery · 20–500 ms" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,8" /><Slider x:Name="ReleaseSlider" Minimum="20" Maximum="500" Value="100" SmallChange="10" LargeChange="25" AutomationProperties.Name="Compressor release in milliseconds" /></StackPanel>
                                    <StackPanel Grid.Column="4"><TextBlock Text="Makeup gain" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="Gain after compression · 0–12 dB" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,8" /><Slider x:Name="MakeupSlider" Minimum="0" Maximum="12" Value="0" SmallChange="0.5" LargeChange="1" AutomationProperties.Name="Compressor makeup gain in decibels" /></StackPanel>
                                </Grid>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,19,0,0">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="28" /><ColumnDefinition /><ColumnDefinition Width="28" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="Transient reduction" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="Reduces sharp peaks, including gunfire and other transients." Foreground="{StaticResource MutedBrush}" FontSize="11" LineHeight="17" TextWrapping="Wrap" MinHeight="41" Margin="0,5,0,8" /><Slider x:Name="TransientSlider" Minimum="0" Maximum="1" Value="0" SmallChange="0.05" LargeChange="0.1" AutomationProperties.Name="Transient reduction amount" /></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Ambience reduction" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="Reduces low-level whole-mix background; may also reduce quiet cues." Foreground="{StaticResource MutedBrush}" FontSize="11" LineHeight="17" TextWrapping="Wrap" MinHeight="41" Margin="0,5,0,8" /><Slider x:Name="AmbienceSlider" Minimum="0" Maximum="1" Value="0" SmallChange="0.05" LargeChange="0.1" AutomationProperties.Name="Ambience reduction amount" /></StackPanel>
                                        <StackPanel Grid.Column="4"><TextBlock Text="Ambience threshold" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="Sets the quiet-level boundary for ambience reduction · −80 to −20 dB." Foreground="{StaticResource MutedBrush}" FontSize="11" LineHeight="17" TextWrapping="Wrap" MinHeight="41" Margin="0,5,0,8" /><Slider x:Name="FloorSlider" Minimum="-80" Maximum="-20" Value="-50" SmallChange="1" LargeChange="5" AutomationProperties.Name="Ambience threshold in decibels" /></StackPanel>
                                    </Grid>
                                </Border>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,19,0,0">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="28" /><ColumnDefinition /><ColumnDefinition Width="28" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="Auto leveling" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="Gated gain control with up to 12 dB of automatic boost." Foreground="{StaticResource MutedBrush}" FontSize="11" LineHeight="17" TextWrapping="Wrap" MinHeight="41" Margin="0,5,0,8" /><Slider x:Name="LevelingSlider" Minimum="0" Maximum="1" Value="0" SmallChange="0.05" LargeChange="0.1" AutomationProperties.Name="Automatic leveling amount" /></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Stereo width" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="Mono through wider stereo. This control does not create 7.1 audio." Foreground="{StaticResource MutedBrush}" FontSize="11" LineHeight="17" TextWrapping="Wrap" MinHeight="41" Margin="0,5,0,8" /><Slider x:Name="WidthSlider" Minimum="0" Maximum="2" Value="1" SmallChange="0.05" LargeChange="0.1" AutomationProperties.Name="Stereo width with one as original width" /></StackPanel>
                                        <StackPanel Grid.Column="4"><TextBlock Text="Balance" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="Shift the level between left and right. Centre keeps both equal." Foreground="{StaticResource MutedBrush}" FontSize="11" LineHeight="17" TextWrapping="Wrap" MinHeight="41" Margin="0,5,0,8" /><Slider x:Name="BalanceSlider" Minimum="-1" Maximum="1" Value="0" SmallChange="0.05" LargeChange="0.1" AutomationProperties.Name="Left and right balance" /></StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="AdvancedValuesText" Text="Attack 4 ms · Release 100 ms · Makeup 0 dB · Original stereo width" Foreground="{StaticResource MutedBrush}" FontSize="12" LineHeight="20" TextWrapping="Wrap" Margin="0,20,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="#162425" BorderBrush="#2E4A48" BorderThickness="1" CornerRadius="8" Padding="15,12" Margin="0,18,0,0"><TextBlock Text="Start at a comfortable volume. A preset is a starting point: your game, hearing, fit and headphones all affect the result." TextWrapping="Wrap" Foreground="#B2C5C1" FontSize="12" LineHeight="19" /></Border>
                    </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="1" Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,16,12,2">
                        <StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="ApplyButton" Content="Apply sound" Style="{StaticResource PrimaryButton}" MinWidth="140" /><Button x:Name="BypassButton" Content="Bypass" Margin="10,0,0,0" /><Button x:Name="RestoreButton" Content="Remove tuning" Margin="10,0,0,0" ToolTip="Remove OpenCue's integration from the audio engine. Other settings are kept." /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="ImportButton" Content="Import preset" /><Button x:Name="ExportButton" Content="Export preset" Margin="10,0,0,0" /></StackPanel></Grid>
                            <Grid Margin="1,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Ready. Set up the free audio engine, choose your device, then apply your sound." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" LineHeight="19" MinHeight="38" Margin="0,0,18,0" /><CheckBox x:Name="LiveToggle" Grid.Column="1" Content="Apply changes live" IsChecked="False" VerticalAlignment="Top" ToolTip="Automatically apply sound adjustments while this option is enabled." /></Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Setup">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,27,12,28">
                        <TextBlock Text="Make it work in three steps." FontSize="30" FontWeight="SemiBold" /><TextBlock Text="OpenCue writes stereo audio settings for Equalizer APO, the free Windows audio processor." Style="{StaticResource Body}" Margin="0,7,0,16" />
                        <Border Background="#162425" BorderBrush="#2E4A48" BorderThickness="1" CornerRadius="8" Padding="16,13" Margin="0,0,0,20"><TextBlock x:Name="SetupProgressText" Text="Ready to start. Windows may ask you to approve the free engine installer." Foreground="#C1E0DA" TextWrapping="Wrap" FontSize="13" LineHeight="21" /></Border>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="25">
                            <StackPanel>
                                <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="30" Height="30" Background="#223D3B" CornerRadius="15" VerticalAlignment="Top"><TextBlock Text="1" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Margin="0,0,20,0"><TextBlock Text="Start the free setup" Style="{StaticResource SectionTitle}" /><TextBlock Text="OpenCue downloads the free audio processor. Approve the Windows installer, keep its default folder, and select your playback device when asked. Restart only if requested." Style="{StaticResource Body}" /></StackPanel><Button x:Name="GetEngineButton" Grid.Column="2" Content="Start setup" Style="{StaticResource PrimaryButton}" VerticalAlignment="Top" /></Grid>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,24" />
                                <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="30" Height="30" Background="#223D3B" CornerRadius="15" VerticalAlignment="Top"><TextBlock Text="2" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Margin="0,0,20,0"><TextBlock Text="Check your headphones" Style="{StaticResource SectionTitle}" /><TextBlock Text="In Device Selector, choose the same device shown in Sound. Select your playback device only, never your microphone. Use Device Selector's built-in test to check that the engine is attached." Style="{StaticResource Body}" /></StackPanel><Button x:Name="SelectorButton" Grid.Column="2" Content="Open Device Selector" VerticalAlignment="Top" /></Grid>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,24" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="30" Height="30" Background="#223D3B" CornerRadius="15" VerticalAlignment="Top"><TextBlock Text="3" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="Choose your sound" Style="{StaticResource SectionTitle}" /><TextBlock Text="After your device passes Device Selector's engine test, return to Sound, choose a preset and select Apply sound. Adjust the controls to suit your ears and headphones." Style="{StaticResource Body}" /><CheckBox x:Name="ScopeAllToggle" Content="Apply to all detected playback outputs" IsChecked="False" Margin="0,14,0,0" /><TextBlock Text="Leave this off to target only the output selected in Sound. Microphone audio is never processed." FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="30,3,0,0" /></StackPanel></Grid>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="23" Margin="0,18,0,0">
                            <StackPanel>
                                <Grid><TextBlock Text="Windows loudness equalization" Style="{StaticResource SectionTitle}" /><TextBlock Text="OPTIONAL" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,8" /></Grid>
                                <TextBlock Text="Optional: open ArtIsWar’s LEQ Control Panel to manage the selected output. It is portable; no separate installation is needed. Windows will ask for administrator approval. In OpenCue, keep the compressor off while testing LEQ so you can compare one change at a time." Style="{StaticResource Body}" />
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button x:Name="LeqButton" Content="Open LEQ Control Panel" /><Button x:Name="LocateLeqButton" Content="Choose .exe…" Margin="10,0,0,0" /></StackPanel>
                                <TextBlock x:Name="LeqStatusText" Text="Checking for the official portable LEQ tool…" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="19" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="23"><StackPanel><TextBlock Text="Check your channels" Style="{StaticResource SectionTitle}" /><TextBlock Text="These samples play through the Windows default output, which may differ from the device selected in Sound. Keep volume low. They check left and right playback, not engine attachment." Style="{StaticResource Body}" /><StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button x:Name="TestLeftButton" Content="Play left" /><Button x:Name="TestRightButton" Content="Play right" Margin="10,0,0,0" /></StackPanel></StackPanel></Border>
                            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="23"><StackPanel><TextBlock Text="Keep your setup in view" Style="{StaticResource SectionTitle}" /><TextBlock Text="Other equalizers or existing APO settings may stack with these changes. Review your configuration if the sound is unexpected." Style="{StaticResource Body}" /><Button x:Name="OpenConfigButton" Content="Open engine configuration" HorizontalAlignment="Left" Margin="0,18,0,0" /></StackPanel></Border>
                        </Grid>
                        <Border Background="#162425" BorderBrush="#2E4A48" BorderThickness="1" CornerRadius="8" Padding="17,14" Margin="0,18,0,0"><TextBlock Text="Audio path matters. Equalizer APO processes supported Windows shared-mode playback. Exclusive-mode apps, some hardware paths and some device effects can bypass it. Use the engine documentation if processing is not audible." Foreground="#B2C5C1" TextWrapping="Wrap" LineHeight="21" FontSize="13" /></Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Spatial &amp; routing">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,27,12,28">
                        <TextBlock Text="Bring surround to your headphones." FontSize="30" FontWeight="SemiBold" />
                        <TextBlock Text="OpenCue renders 7.1 game audio to binaural stereo using measured KEMAR responses. This route requires a separate eight-channel virtual audio output and a matching recording input." Style="{StaticResource Body}" Margin="0,7,0,23" />
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="23">
                            <StackPanel>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="7.1 headphone rendering" Style="{StaticResource SectionTitle}" /><CheckBox x:Name="SpatialToggle" Grid.Column="1" Content="Render 7.1 for headphones" IsChecked="False" Margin="20,0,0,0" /></Grid>
                                <TextBlock Text="Virtual processing output (7.1 or official 16ch)" Style="{StaticResource Label}" Margin="0,15,0,8" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox x:Name="SpatialPlaybackBox" AutomationProperties.Name="Virtual processing output for 7.1 or official 16-channel audio" /><Button x:Name="SpatialApplyButton" Grid.Column="1" Content="Apply 7.1 rendering" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" /><Button x:Name="UseStereoButton" Grid.Column="2" Content="Return to stereo" Margin="10,0,0,0" /></Grid>
                                <TextBlock x:Name="SpatialSetupText" Text="Choose a virtual playback output configured for eight channels at 48 kHz. Apply rendering after attaching Equalizer APO to that output." Style="{StaticResource Body}" FontSize="12" Margin="0,13,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="23" Margin="0,17,0,0">
                            <StackPanel>
                                <TextBlock Text="Connect the route" Style="{StaticResource SectionTitle}" />
                                <Grid Margin="0,12,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="28" Height="28" CornerRadius="14" Background="#223D3B" VerticalAlignment="Top"><TextBlock Text="1" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Margin="0,0,20,0"><TextBlock Text="Add a virtual cable" FontWeight="SemiBold" FontSize="15" Margin="0,1,0,6" /><TextBlock Text="Use a virtual audio cable with matching playback and recording devices. The OpenCue 7.1 route needs eight channels." Style="{StaticResource Body}" /></StackPanel><Button x:Name="CableButton" Grid.Column="2" Content="Set up virtual cable" VerticalAlignment="Top" /></Grid>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,19" />
                                <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="28" Height="28" CornerRadius="14" Background="#223D3B" VerticalAlignment="Top"><TextBlock Text="2" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Margin="0,0,20,0"><TextBlock Text="Configure the virtual playback device" FontWeight="SemiBold" FontSize="15" Margin="0,1,0,6" /><TextBlock Text="In Windows sound settings, configure it as 7.1 at 48 kHz. Attach Equalizer APO using Device Selector in Setup, then select that output above and apply 7.1 rendering." Style="{StaticResource Body}" /></StackPanel><Button x:Name="SoundSettingsButton" Grid.Column="2" Content="Open Windows sound settings" VerticalAlignment="Top" /></Grid>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,19" />
                                <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition /></Grid.ColumnDefinitions><Border Width="28" Height="28" CornerRadius="14" Background="#223D3B" VerticalAlignment="Top"><TextBlock Text="3" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="Send game audio into the cable" FontWeight="SemiBold" FontSize="15" Margin="0,1,0,6" /><TextBlock Text="Choose the virtual playback device as the game's audio output. Below, choose that cable's matching virtual recording device as the relay input." Style="{StaticResource Body}" /></StackPanel></Grid>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,19" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition /></Grid.ColumnDefinitions><Border Width="28" Height="28" CornerRadius="14" Background="#223D3B" VerticalAlignment="Top"><TextBlock Text="4" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="Listen through your headphones" FontWeight="SemiBold" FontSize="15" Margin="0,1,0,6" /><TextBlock Text="Choose your physical headphones as the relay output, select the matching route mode, and select Start game audio. Begin at a comfortable volume." Style="{StaticResource Body}" /></StackPanel></Grid>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="23" Margin="0,17,0,0">
                            <StackPanel>
                                <Grid><TextBlock Text="Game audio relay" Style="{StaticResource SectionTitle}" /><Button x:Name="RelayRefreshButton" Content="Refresh devices" HorizontalAlignment="Right" Padding="12,7" MinHeight="32" /></Grid>
                                <TextBlock Text="Route the cable's recording audio to your physical headphone output." Style="{StaticResource Body}" FontSize="12" Margin="0,3,0,19" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="24" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="VIRTUAL RECORDING INPUT" Style="{StaticResource Label}" /><ComboBox x:Name="RelayInputBox" AutomationProperties.Name="Relay virtual recording input" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="PHYSICAL HEADPHONE OUTPUT" Style="{StaticResource Label}" /><ComboBox x:Name="RelayOutputBox" AutomationProperties.Name="Relay physical headphone output" /></StackPanel></Grid>
                                <TextBlock Text="ROUTE MODE" Style="{StaticResource Label}" Margin="0,20,0,8" />
                                <ComboBox x:Name="RelayModeBox" AutomationProperties.Name="Audio relay route mode" />
                                <Grid Margin="0,21,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="28" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Buffer / latency" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="20–200 ms · increase if playback breaks up" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,8" /><Slider x:Name="RelayLatencySlider" Minimum="20" Maximum="200" Value="60" SmallChange="5" LargeChange="10" AutomationProperties.Name="Relay buffer in milliseconds" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Playback level" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="Start low, then adjust for comfort." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,8" /><Slider x:Name="RelayVolumeSlider" Minimum="0" Maximum="1" Value="0.8" SmallChange="0.05" LargeChange="0.1" AutomationProperties.Name="Relay playback level" /></StackPanel></Grid>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,17,0,0" Padding="0,18,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="RelayStartButton" Content="Start game audio" Style="{StaticResource PrimaryButton}" /><Button x:Name="RelayStopButton" Content="Stop" Margin="10,0,0,0" /></StackPanel><StackPanel Grid.Column="1" Margin="25,0,0,0" VerticalAlignment="Center"><TextBlock Text="INPUT PEAK" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,7" /><ProgressBar x:Name="RelayMeter" Minimum="0" Maximum="1" Value="0" Height="7" Background="#10161D" Foreground="{StaticResource AccentBrush}" BorderThickness="0" AutomationProperties.Name="Actual relay input peak"><ProgressBar.Template><ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track" Background="{TemplateBinding Background}" ClipToBounds="True"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3" /></Grid></ControlTemplate></ProgressBar.Template></ProgressBar></StackPanel></Grid></Border>
                                <TextBlock x:Name="RelayStatusText" Text="Relay stopped. Select matching input and output devices before starting." Style="{StaticResource Body}" FontSize="12" Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="#162425" BorderBrush="#2E4A48" BorderThickness="1" CornerRadius="10" Padding="21,18" Margin="0,17,0,0"><StackPanel><TextBlock Text="Using the official ArtTune route?" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" /><TextBlock Text="OpenCue's original 7.1 renderer and the official ArtTune 16-channel engine are separate routes. The official route requires a correctly installed ArtTune engine, its unmodified installed preset and matching local Bravo DLL, and matching 16-channel virtual playback and recording devices. Follow the official setup and its licence terms." Foreground="#B2C5C1" FontSize="13" TextWrapping="Wrap" LineHeight="22" /><StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button x:Name="ArtSetupButton" Content="Set up official ArtTune" /><Button x:Name="LoadArtProfileButton" Content="Load installed 16ch preset" Margin="10,0,0,0" /></StackPanel><TextBlock x:Name="ArtProfileText" Text="No official 16-channel preset loaded." Foreground="#B2C5C1" FontSize="12" TextWrapping="Wrap" LineHeight="20" Margin="0,12,0,0" /></StackPanel></Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="2" Margin="0,12,0,12"><TextBlock Text="YOUR SOUND. YOUR CONTROLS." FontSize="9" FontWeight="SemiBold" Foreground="#758391" /><TextBlock Text="OpenCue  /  Windows audio utility" FontSize="10" Foreground="#758391" HorizontalAlignment="Right" /></Grid>
    </Grid>
</Window>
